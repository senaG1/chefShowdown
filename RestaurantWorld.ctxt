comment4.params=side\ effectType
comment4.target=void\ trySpawnEffect(java.lang.String,\ java.lang.String)
comment4.text=\r\n\ Attempts\ to\ spawn\ an\ effect\ on\ the\ specified\ side\ if\ no\ effect\ is\ currently\ active.\r\n\ Uses\ cooldown\ timer\ to\ prevent\ multiple\ effects\ on\ same\ side\ simultaneously.\r\n\ \r\n\ @param\ side\ The\ restaurant\ side\ to\ affect\ ("Blue"\ or\ "Red")\r\n\ @param\ effectType\ The\ type\ of\ effect\ to\ spawn\ ("PowerOutage"\ or\ "RatInfestation")\r\n
comment5.params=side\ effectType
comment5.target=void\ spawnEffect(java.lang.String,\ java.lang.String)
comment5.text=\r\n\ Spawns\ a\ Power\ Outage\ or\ Rat\ Infestation\ effect\ at\ a\ specified\ side\ and\ coordinate\r\n\ \r\n\ @param\ side\ \ \ \ \ \ Takes\ which\ side\ of\ the\ world\ (which\ restaurant)\r\n\ @param\ type\ \ \ \ \ \ Takes\ the\ type\ of\ effect\ to\ spawn\r\n
comment6.params=
comment6.target=void\ stopped()
comment6.text=\r\n\ Called\ when\ the\ world\ is\ stopped.\ Stops\ all\ background\ music\ and\ sound\ effects.\r\n
comment7.params=
comment7.target=void\ started()
comment7.text=\r\n\ Called\ when\ the\ world\ is\ started/resumed.\ Restarts\ background\ music\ only\ if\ resuming.\r\n
